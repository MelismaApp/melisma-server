# Copy to .kamal/secrets and fill in. That file is gitignored — it holds real credentials.
#
# Kamal reads these when building the `env.secret` list in config/deploy.yml. Anything left
# blank is simply not passed to the container, and the matching source stays quiet rather
# than failing.

# --- container registry (required) ---
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# --- the server's own key (recommended) ---
# Every request from the app carries this, and the admin page asks for it. Set it here so it is
# known before the first boot and survives a rebuilt volume. Generate one with:
#   node -e "console.log(crypto.randomBytes(24).toString('hex'))"
BL_API_KEY=

# --- Apple Music (optional, and the whole point of the server) ---
# Two tokens, and a subscription only gets you one. See the README for where each comes from.
# The bearer is a JWT that lasts months; the media user token dies with the browser session, so
# expect to replace that one and redeploy — or paste it into the admin page instead, which
# needs no deploy.
BL_APPLE_BEARER_TOKEN=
BL_APPLE_MEDIA_USER_TOKEN=

# --- Spotify (optional) ---
# The cookie is the one worth setting: the image carries a Chromium, so with sp_dc present the
# hour-long web token renews itself every fifty minutes and never needs pasting. From a signed-in
# open.spotify.com: DevTools -> Application -> Cookies -> sp_dc. Lasts about a year.
BL_SP_DC_COOKIE=

# The web token itself, if you want a working one before the first refresh runs. Optional, and
# stale within the hour either way.
BL_SPOTIFY_WEB_TOKEN=

# A registered Spotify application, from developer.spotify.com/dashboard (tick Web API only).
# Optional, and only for the public catalogue: this is what makes the ISRC and the cover art
# reliable, because api.spotify.com rate-limits a web-player token hard. It does not replace the
# cookie above — lyrics and the audio analysis still need the player's own token.
# Can be pasted into the admin page instead; either way, blank here means "not set".
BL_SPOTIFY_CLIENT_ID=
BL_SPOTIFY_CLIENT_SECRET=

# --- the rest (all optional) ---
BL_MUSIXMATCH_USER_TOKEN=
BL_NETEASE_COOKIE=
